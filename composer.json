{
    "name": "caremillc/flint",
    "description": "The Flint application skeleton.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "caremillc/framework": "dev-main"
    },
    "repositories": [
        {
            "type": "path",
            "url": "framework",
            "options": {
                "versions": {
                    "caremillc/framework": "dev-main"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "test": "@php tests/bootstrap.php",
        "test:configuration": "@php tests/configuration-bootstrap.php",
        "test:configuration-validation": "@php tests/configuration-validation.php",
        "check": [
            "@composer validate --strict",
            "@composer dump-autoload --optimize --strict-psr --strict-ambiguous",
            "@composer check-platform-reqs",
            "@php -l bootstrap/app.php",
            "@php -l bootstrap/configuration.php",
            "@php -l config/defaults.php",
            "@php -l app/Configuration/ApplicationConfigurationValidator.php",
            "@php -l tests/bootstrap.php",
            "@php -l tests/configuration-bootstrap.php",
            "@php -l tests/configuration-validation.php",
            "@test",
            "@test:configuration",
            "@test:configuration-validation"
        ]
    },
    "config": {
        "sort-packages": true
    }
}