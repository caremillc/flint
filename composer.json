{
    "name": "caremillc/flint",
    "description": "The Flint application skeleton.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "caremillc/framework": "dev-main"
    },
    "repositories": [
        {
            "type": "path",
            "url": "framework",
            "options": {
                "versions": {
                    "caremillc/framework": "dev-main"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "lint": "@php bin/lint.php",
        "test": "@php tests/bootstrap.php",
        "test:configuration": "@php tests/configuration-bootstrap.php",
        "test:configuration-validation": "@php tests/configuration-validation.php",
        "test:http": "@php framework/bin/http-smoke.php",
        "test:http-bootstrap": "@php tests/http-bootstrap.php",
        "test:http-application": "bash bin/application-http-smoke.sh",
        "test:http-middleware": "@php tests/http-middleware.php",
        "test:request-id": "@php tests/request-id.php",
        "test:exception-reporting": "@php tests/exception-reporting.php",
        "test:http-failure": "bash bin/application-http-failure-smoke.sh",
        "cs:check": "@composer --working-dir=framework cs:check",
        "cs:fix": "@composer --working-dir=framework cs:fix",
        "test:response-policy": "@php tests/response-policy.php",
        "test:access-logging": "@php tests/access-logging.php",
        "test:query-middleware": "@php tests/query-middleware.php",
        "test:greeting": "@php tests/greeting-handler.php",
        "test:json-greeting": "@php tests/json-greeting.php",
        "test:json-greeting-bootstrap": "@php tests/json-greeting-bootstrap.php",
        "test:json-greeting-input": "@php tests/json-greeting-input.php",
        "test:route-handlers": "@php tests/route-handlers.php",
        "analyse:application": "@php framework/vendor/bin/phpstan analyse --configuration=phpstan.application.neon.dist --no-progress --memory-limit=512M",
        "analyse": [
            "@composer --working-dir=framework analyse",
            "@analyse:application"
        ],
        "test:framework": "@composer --working-dir=framework test",
        "test:route-groups": "@php tests/route-groups.php",
        "test:container-middleware": "@php tests/container-middleware.php",
        "test:route-constraints": "@php tests/route-constraints.php",
        "routes": "@php bin/routes.php",
        "test:routes-command": "@php tests/routes-command.php",
        "route:url": "@php bin/route-url.php",
        "test:route-url-command": "@php tests/route-url-command.php",
        "test:routes-bootstrap": "@php tests/routes-bootstrap.php",
        "test:route-links": "@php tests/route-links.php",
        "test:route-access-logging": "@php tests/route-access-logging.php",
        "check": [
            "@composer validate --strict",
            "@composer dump-autoload --optimize --strict-psr --strict-ambiguous",
            "@composer check-platform-reqs",
            "@lint",
            "@php -l routes/web.php",
            "@test",
            "@test:configuration",
            "@test:configuration-validation",
            "@test:http-bootstrap",
            "@test:http-middleware",
            "@test:request-id",
            "@test:exception-reporting",
            "@test:response-policy",
            "@test:access-logging",
            "@test:query-middleware",
            "@test:greeting",
            "@test:json-greeting",
            "@test:json-greeting-bootstrap",
            "@analyse:application",
            "@test:json-greeting-input",
            "@test:route-handlers",
            "@test:route-groups",
            "@test:container-middleware",
            "@test:route-constraints",
            "@test:routes-command",
            "@test:route-url-command",
            "@test:routes-bootstrap",
            "@test:route-links",
            "@test:route-access-logging"
        ],
        "check:framework": "@composer --working-dir=framework check",
        "check:all": [
            "@check:framework",
            "@check",
            "@test:http",
            "@test:http-application",
            "@test:http-failure"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95"
    }
}